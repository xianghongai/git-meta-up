{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // The package uses the ECMAScript library only, no DOM or Node types, so it runs in both.
    "lib": ["ES2023"],
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/**/*.ts", "types/whatwg-url.d.ts"]
}
